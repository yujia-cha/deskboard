{
  "$schema": "../widget.schema.json",
  "title": "Claude 한도",
  "icon": "✨",
  "description": "Claude 5시간·주간 사용 한도와 남은 시간을 표시",
  "entry": "index.tsx",
  "provider": "claude_usage",
  "defaultSize": { "w": 340, "h": 170 },
  "minSize": { "w": 200, "h": 100 },
