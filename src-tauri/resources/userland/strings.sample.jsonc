// deskboard 문구 샘플 — 이 파일은 앱이 시작할 때마다 다시 써집니다. 직접 고치지 마세요.
//
// 쓰는 법: 같은 폴더에 `strings.jsonc` 라는 이름으로 복사한 뒤 바꾸고 싶은 문구만 남기세요.
// 적지 않은 문구는 아래 기본값을 씁니다. 저장하면 바로 반영됩니다.
{
  // 트레이 아이콘 메뉴
  "tray": {
    "toggle_lock": "편집 잠금/해제",
    "toggle_theme": "반투명/단색 전환",
    "settings": "설정...",
    "show": "표시/숨기기",
    "quit": "종료",
    "tooltip": "deskboard"   // 아이콘에 마우스를 올렸을 때 나오는 글
  },

  // 편집 모드 하단 바
  "editBar": {
    "hint": "편집 모드 — 헤더 드래그: 이동 · 빈 곳 드래그: 여러 개 선택 · Ctrl/Shift 클릭: 추가 · 테두리·모서리 드래그: 크기",
    "multi": "{n}개 선택 — 하나를 끌면 함께 움직입니다 · Esc: 선택 해제",   // {n} = 선택한 개수
    "settings": "⚙ 설정",
    "lock": "🔒 잠금"
  }
}
