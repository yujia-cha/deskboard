// deskboard 설정 샘플 — 이 파일은 앱이 시작할 때마다 다시 써집니다. 직접 고치지 마세요.
//
// 쓰는 법: 이 파일을 같은 폴더에 `config.jsonc` 라는 이름으로 복사한 뒤, 바꾸고 싶은 항목만 남겨 두세요.
// 적지 않은 항목은 아래의 기본값을 씁니다. 저장하면 바로 반영됩니다.
// 문법이 틀리면 그 파일은 무시되고 설정 패널에 `줄:칸` 오류가 표시됩니다.
// 주석(// 와 /* */)과 마지막 쉼표는 써도 됩니다.
{
  // 새로 쓰는 값의 기본값. 이미 저장된 사용자의 선택(설정 패널에서 고른 값)이 항상 우선합니다.
  "defaults": {
    "themeMode": "translucent",   // "translucent"(반투명) | "solid"(단색)
    "palette": "dark",            // "dark" | "light" | "auto"(OS 테마 따라감)
    "cardStyle": "glass",         // "glass" | "minimal" | "borderless" | "none"
    "surfaceOpacity": 62,         // 카드 불투명도 0~100
    "blurStrength": 3,            // 배경 블러 강도
    "cornerRadius": 16,           // 카드 모서리 반경 px (0~40)
    "borderStrength": 65,         // 테두리 진하기 0~100
    "borderWidth": 1,             // 테두리 두께 px (1~6)
    "accent": "#7c9cff",          // 강조색
    "gridSnap": 8,                // 이동·크기 조절 격자 px (0 = 끔)
    "autoScale": true             // 카드 크기에 맞춰 내용 자동 확대/축소
  },

  "layout": {
    // 설정 패널의 크기 프리셋. k = 기본 크기 대비 배율
    "sizePresets": [
      { "label": "작게", "k": 0.75 },
      { "label": "기본", "k": 1 },
      { "label": "크게", "k": 1.4 },
      { "label": "아주 크게", "k": 1.8 }
    ],
    // 내용 자동 배율의 한계
    "contentScale": { "min": 0.6, "max": 2.5 },
    // 새 위젯을 놓을 빈자리를 찾는 간격 (step: 후보 칸 간격, margin: 화면 가장자리 여백)
    "freeSlot": { "step": 40, "margin": 24 },
    // 처음 실행했을 때(저장된 배치가 없을 때) 놓일 위젯과 위치·크기 (px, 작업영역 좌표)
    "default": [
      { "widget": "settings",     "x": 1104, "y": 24,  "w": 56,  "h": 56 },
      { "widget": "clock",        "x": 24,   "y": 24,  "w": 300, "h": 140 },
      { "widget": "sysmon",       "x": 24,   "y": 184, "w": 360, "h": 240 },
      { "widget": "claude-usage", "x": 404,  "y": 24,  "w": 340, "h": 150 },
      { "widget": "spotify",      "x": 404,  "y": 194, "w": 340, "h": 320 },
      { "widget": "calendar",     "x": 764,  "y": 24,  "w": 320, "h": 400 }
    ]
  },

  // 위젯별 덮어쓰기. 키는 위젯 id(폴더 이름). 적은 항목만 widget.json 의 값을 대신합니다.
  "widgets": {
    // "clock": {
    //   "title": "시계",                       // 이름
    //   "icon": "🕒",                          // 아이콘
    //   "defaultSize": { "w": 300, "h": 140 }, // 새로 추가할 때의 크기
    //   "minSize": { "w": 160, "h": 80 },      // 줄일 수 있는 최소 크기
    //   "settings": { "style": "neon" },       // 설정 기본값 (설정 스키마의 key 와 같은 이름)
    //   "hidden": false                        // true 면 "위젯 추가" 목록에서 숨김
    // }
  },

  // 데이터 갱신 주기 (초). 아래 값이 기본값이고, 괄호 안은 허용하는 최솟값입니다.
  "intervals": {
    "sysmon": 2,         // 시스템 모니터 (최소 1)
    "weather": 900,      // 날씨 (최소 300)
    "github": 300,       // GitHub (최소 60)
    "spotify": 5,        // Spotify 재생 상태 (최소 2)
    "claudeUsage": 120   // Claude 사용량 (최소 60)
  }
}
