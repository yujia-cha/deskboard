    { "key": "showLocalCost", "label": "로컬 추정 비용 표시 (오늘/7일)", "type": "boolean", "default": false },
    { "key": "krwRate", "label": "원화 환율 (0=숨김)", "type": "number", "default": 1380, "min": 0, "step": 10 }
  ]
}
