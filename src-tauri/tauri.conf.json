{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deskboard",
  "version": "0.4.0",
  "identifier": "com.user.deskboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "deskboard",
        "width": 1100,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnBottom": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/yujia-cha/deskboard/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFQTE3QzkzODkwNTYxMQpSV1FSVnBBNHlSZnFBWjZvc01yM0wvUHdxMTBGall3VHFFL2g3RVZHRllsNVQxTWs1YWdsbml5Qwo=",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "deskboard",
    "copyright": "",
    "category": "Utility",
    "shortDescription": "Windows 바탕화면 위젯 대시보드",
    "longDescription": "바탕화면 바로 위에 머무는 투명한 위젯 대시보드 — 시계, 시스템 모니터, 캘린더, 날씨, 메모, Spotify, GitHub, Claude 사용량 등.",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis-hooks.nsh",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
