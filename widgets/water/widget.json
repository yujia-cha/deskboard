{
  "$schema": "../widget.schema.json",
  "title": "물통",
  "icon": "💧",
  "description": "통에 담긴 픽셀 물. 안쪽을 끌면 흔들고, 가장자리(점선 고리)를 끌면 돌립니다. 휠: 15°씩 회전 · 더블클릭: 원위치.",
  "entry": "index.tsx",
  "defaultSize": { "w": 200, "h": 200 },
  "minSize": { "w": 120, "h": 120 },
  "settingsSchema": [
    { "key": "note", "type": "note", "label": "통 안쪽을 끌면 흔들고, 가장자리(점선 고리)를 끌면 돌립니다. 휠: 15°씩 회전 · 더블클릭: 원위치." },
    { "key": "preset", "label": "물성", "type": "select", "default": "water",
      "options": [
        { "value": "water", "label": "물" },
        { "value": "honey", "label": "꿀 (끈적함)" },
        { "value": "jelly", "label": "젤리 (뭉치고 튕김)" },
        { "value": "zerog", "label": "무중력" },
        { "value": "moon", "label": "달 (중력 1/6)" },
        { "value": "custom", "label": "직접 조정" }
      ] },
    { "key": "gravity", "label": "중력", "type": "range", "default": 9.8, "min": 0, "max": 30, "step": 0.1, "unit": " m/s²", "showIf": { "key": "preset", "equals": "custom" } },
    { "key": "gravityDir", "label": "중력 방향", "type": "range", "default": 0, "min": -180, "max": 180, "step": 5, "unit": "°", "showIf": { "key": "preset", "equals": "custom" } },
    { "key": "viscosity", "label": "점성", "type": "range", "default": 5, "min": 0, "max": 100, "step": 1, "showIf": { "key": "preset", "equals": "custom" } },
    { "key": "splash", "label": "튐", "type": "range", "default": 90, "min": 0, "max": 100, "step": 1, "showIf": { "key": "preset", "equals": "custom" } },
    { "key": "cohesion", "label": "표면장력·응집", "type": "range", "default": 10, "min": 0, "max": 100, "step": 1, "showIf": { "key": "preset", "equals": "custom" } },
    { "key": "wallFriction", "label": "벽 마찰", "type": "range", "default": 10, "min": 0, "max": 100, "step": 1, "showIf": { "key": "preset", "equals": "custom" } },
    { "key": "bounce", "label": "벽 반발", "type": "range", "default": 0, "min": 0, "max": 100, "step": 1, "showIf": { "key": "preset", "equals": "custom" } },
    { "key": "inertia", "label": "흔들림 민감도", "type": "range", "default": 100, "min": 0, "max": 200, "step": 5, "unit": "%", "showIf": { "key": "preset", "equals": "custom" } },
    { "key": "timeScale", "label": "시간 배율", "type": "range", "default": 100, "min": 25, "max": 200, "step": 5, "unit": "%", "showIf": { "key": "preset", "equals": "custom" } },
    { "key": "fill", "label": "물 양", "type": "range", "default": 45, "min": 10, "max": 80, "step": 5, "unit": "%" },
    { "key": "pixelSize", "label": "입자 크기", "type": "range", "default": 2, "min": 1, "max": 4, "step": 1, "unit": " px" },
    { "key": "shape", "label": "통 모양", "type": "select", "default": "square",
      "options": [{ "value": "square", "label": "사각" }, { "value": "round", "label": "원형" }] },
    { "key": "quality", "label": "품질", "type": "select", "default": "medium",
      "options": [
        { "value": "low", "label": "낮음 (가벼움)" },
        { "value": "medium", "label": "보통" },
        { "value": "high", "label": "높음 (압력을 더 정확히)" }
      ] },
    { "key": "returnHome", "label": "놓으면 제자리로", "type": "boolean", "default": true },
    { "key": "color", "label": "물 색 (비우면 강조색)", "type": "text", "default": "", "placeholder": "#4fd1c5" }
  ]
}
